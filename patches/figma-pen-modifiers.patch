+(defn modify-bend-handler
+  "Like modify-handler but mirrors both angle and length, so dragging one
+  handler from a corner pulls out symmetric handles (bend-drag)."
+  [id index prefix dx dy]
+  (ptk/reify ::modify-bend-handler
+    ptk/UpdateEvent
+    (update [_ state]
+      (let [content (st/get-path state :content)
+            modifiers (helpers/move-handler-modifiers content index prefix true true dx dy)
+            [cx cy] (if (= prefix :c1) [:c1x :c1y] [:c2x :c2y])
+            point (gpt/point (+ (dm/get-in content [index :params cx]) dx)
+                             (+ (dm/get-in content [index :params cy]) dy))]
+        (-> state
+            (update-in [:workspace-local :edit-path id :content-modifiers] merge modifiers)
+            (assoc-in [:workspace-local :edit-path id :moving-handler] point))))))
+
+(defn start-bend-drag
+  "Drag a corner point's handler symmetrically to pull out new handles.
+  Assumes the point already has handler entries (curve-to); if it is a
+  line-to corner, call make-curve first."
+  [position shift?]
+  (ptk/reify ::start-bend-drag
+    ptk/WatchEvent
+    (watch [_ state stream]
+      (let [id (dm/get-in state [:workspace-local :edition])
+            content (st/get-path state :content)
+            handlers (get (path/get-handlers content) position)
+            [index prefix] (first handlers)]
+        (if (some? index)
+          (let [cx (d/prefix-keyword prefix :x)
+                cy (d/prefix-keyword prefix :y)
+                modifiers (dm/get-in state [:workspace-local :edit-path id :content-modifiers])
+                start-delta-x (dm/get-in modifiers [index cx] 0)
+                start-delta-y (dm/get-in modifiers [index cy] 0)
+                points (path/get-points content)
+                point position
+                handler (path/get-handler-point content index prefix)
+                [op-idx op-prefix] (path/opposite-index content index prefix)
+                opposite (path/get-handler-point content op-idx op-prefix)]
+            (streams/drag-stream
+             (rx/concat
+              (rx/of (dwsh/update-shapes [id] path/convert-to-path)
+                     (selection/select-node position shift?))
+              (->> (streams/move-handler-stream handler point handler opposite points)
+                   (rx/map
+                    (fn [{:keys [x y shift?]}]
+                      (let [pos (cond-> (gpt/point x y)
+                                  shift? (path.helpers/position-fixed-angle point))]
+                        (modify-bend-handler
+                         id
+                         index
+                         prefix
+                         (+ start-delta-x (- (:x pos) (:x handler)))
+                         (+ start-delta-y (- (:y pos) (:y handler)))))))
+                   (rx/take-until
+                    (rx/merge
+                     (mse/drag-stopper stream)
+                     (->> stream
+                          (rx/filter streams/finish-edition?)))))
+              (rx/concat (rx/of (apply-content-modifiers))))))
+          ;; No handler entries (line-to corner that wasn't converted):
+          ;; fall back to moving the point itself.
+          (rx/of (start-move-path-point position shift?)))))))
+
+(defn prepare-bend-point
+  "Synchronously converts a straight (line-to) corner into a curve, so a
+  bend-drag that follows in the same stream is guaranteed handler entries
+  to work with. No-op when the point already has handlers. Runs as an
+  UpdateEvent (like split-segments' direct set-content), so the drag
+  observes converted content with no async gap; the drag-end
+  apply-content-modifiers commit covers the whole gesture."
+  [position]
+  (ptk/reify ::prepare-bend-point
+    ptk/UpdateEvent
+    (update [_ state]
+      (let [content (st/get-path state :content)
+            handlers (get (path/get-handlers content) position)]
+        (if (seq handlers)
+          state
+          (st/set-content state (-> content
+                                    (path/make-curve-point position)
+                                    (path/content))))))))
+
+(defn prepare-rebend-point
+  "Synchronously collapses a handled point's bezier handles back onto the
+  anchor (keeping :curve-to commands, unlike make-corner-point which may
+  revert segments to :line-to), so a bend-drag that follows in the same
+  stream pulls a fresh mirrored pair out from center. No-op when the point
+  has no handler entries. Same direct set-content pattern as
+  prepare-bend-point."
+  [position]
+  (ptk/reify ::prepare-rebend-point
+    ptk/UpdateEvent
+    (update [_ state]
+      (let [content (st/get-path state :content)
+            handler-refs (path/handler-indices content position)]
+        (if (empty? handler-refs)
+          state
+          (st/set-content state
+            (-> (reduce (fn [c [index prefix]]
+                          (let [[cx cy] (path.helpers/prefix->coords prefix)]
+                            (-> c
+                                (assoc-in [index :params cx] (:x position))
+                                (assoc-in [index :params cy] (:y position)))))
+                        (vec content)
+                        handler-refs)
+                (path/content))))))))
+
+(defn start-bend-point
+  "Cmd bend/mirror on an anchor (Figma):
+  - click toggles corner <-> curve (straight/mirrored),
+  - drag on a corner pulls out new symmetric handles,
+  - drag on a handled point collapses its handles and pulls a fresh
+    mirrored pair out from center (reset + pull in one gesture)."
+  [position shift? is-curve?]
+  (ptk/reify ::start-bend-point
+    ptk/WatchEvent
+    (watch [_ _ _]
+      (let [click-events (rx/of (if is-curve?
+                                  (tools/make-corner position)
+                                  (tools/make-curve position)))
+            drag-events (if is-curve?
+                          (rx/concat
+                           (rx/of (prepare-rebend-point position))
+                           (rx/of (start-bend-drag position shift?)))
+                          (rx/concat
+                           (rx/of (prepare-bend-point position))
+                           (rx/of (start-bend-drag position shift?))))]
+        (streams/drag-stream drag-events click-events)))))
+
 
 (defn start-path-edit
   [id]
