<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.penpot.server</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__PENPOT_ROOT__/bin/penpot-local</string>
		<string>watch</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>__PENPOT_ROOT__/logs/launchd.log</string>
	<key>StandardErrorPath</key>
	<string>__PENPOT_ROOT__/logs/launchd.log</string>
</dict>
</plist>
